# ---- SiliconFlow (LLM provider) ----
# Used by the standalone connectivity demo and the `real` debate provider.
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_API_KEY=replace-with-your-api-key

# ---- FoodArena application ----
# Debate provider: "mock" (deterministic, offline, no key needed) or "real".
FOODARENA_PROVIDER=mock
# SQLite file used by the backend when not overridden by the container mount.
FOODARENA_DATABASE_URL=sqlite:///./foodarena.db
# Port the API listens on when launched via the `foodarena-api` script.
FOODARENA_PORT=8000
# Optional static directory from which the API serves the built SPA.
# FOODARENA_STATIC_DIR=frontend/dist

# ---- Frontend ----
# Where the browser reaches the API. Empty = same origin (Vite dev proxy /
# nginx compose). Set to a full URL when the API lives elsewhere.
# VITE_API_BASE_URL=http://localhost:8000
